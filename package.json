{
  "name": "zcode-usage-stats",
  "version": "0.1.4",
  "description": "仿zcode的使用统计：在 DeepSeek Harness(DSH) 设置页渲染全量会话的 Token 用量统计——按天/按小时趋势图、模型用量仪表盘、活跃热力图，支持今天/昨天/最近7·30天/本月/上月/自定义区间。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "pack": "npm pack",
    "test": "node tests/host-scan.cjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "token",
    "usage",
    "statistics",
    "使用统计"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
